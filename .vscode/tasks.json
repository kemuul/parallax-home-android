{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Android: Build debug APK",
            "type": "shell",
            "command": "${workspaceFolder}\\gradlew.bat",
            "args": ["assembleDebug"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gradle"]
        },
        {
            "label": "Android: Install debug APK",
            "type": "shell",
            "command": "adb",
            "args": [
                "install",
                "-r",
                "${workspaceFolder}\\app\\build\\outputs\\apk\\debug\\app-debug.apk"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Android: Build debug APK",
            "problemMatcher": []
        }
    ]
}
